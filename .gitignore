# Rust
/target/
**/target/
**/*.rs.bk
*.rlib
Cargo.lock

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/

# IDE
.idea/
.vscode/
.codex/
.claude/*
# …but keep the grill-to-plan design records (GRILL/PRD/PLAN) version-controlled
!.claude/specs/
# grill-to-plan artifacts (GRILL/PRD/PLAN) are project records, like .claude/specs/
!.claude/sekekama/
.claude/sekekama/*
!.claude/sekekama/grill-to-plan/
.claude/sekekama/grill-to-plan/*
!.claude/sekekama/grill-to-plan/specs/

# Session-handoff scratch (per-session continuity notes; not project records).
# (.claude/sekekama/session-handoff/ is already covered by the .claude/sekekama/* rule above.)
.handoff/

# Tool config
.mcp.json
*.swp
*.swo
*~

# Verification logs (machine-generated)
/logs/verify/
/logs/results/
/output/

# MIR/HIR dumps (machine-generated, used for hand-lowering)
mir-dump/
**/mir-dump/
tests/fixtures/*/dump/

# OS
.DS_Store
Thumbs.db

# Working / scratch areas (per-author notes; not part of the spec or harness)
docs/discussions/regseq-model/tmp/
