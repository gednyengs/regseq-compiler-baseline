LC register pl011pin match=amba:0x41011/0xfffff
BUS register_driver path=amba binding=bound
LC create
LC associate
LC preamble regs
BUS claim_regions bar=-1
BUS get_handle
BUS map base=0x9000000 size=0x1000 bar=-1
PIN acquire uart_pins default
LC call on_init
PIN apply uart_pins sleep
W32 @0x9000000 = 0x00000042
PIN apply uart_pins default
LC teardown present=1
LC call on_deinit
PIN release uart_pins
LC postamble regs
