# Apply this on top of Buildroot's qemu_aarch64_virt_defconfig to recreate
# the current PL011-oriented guest rootfs baseline used in the experiment.

# Keep the rootfs independent from a Buildroot-managed kernel/QEMU workflow.
# BR2_LINUX_KERNEL is not set
# BR2_PACKAGE_HOST_QEMU is not set
BR2_ROOTFS_POST_IMAGE_SCRIPT=""

# The guest only needs module loading support for the PL011 smoke path.
BR2_PACKAGE_KMOD=y

# Default PL011 profile: no guest NIC, no auto eth0 bring-up.
BR2_SYSTEM_DHCP=""

# Current image size used successfully in the experiment.
BR2_TARGET_ROOTFS_EXT2_SIZE="60M"
